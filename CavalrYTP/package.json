{
	"name": "cavarytp",
	"displayName": "CavalrYTP",
	"version": "1.0.0",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@11.21.0",
	"scripts": {
		"dev": "cross-env NODE_ENV=development bundler",
		"release": "cross-env NODE_ENV=production bundler && pnpm run publish:jsc",
		"publish:jsc": "node -e \"require('fs').copyFileSync('build/CavalrYTP.jsc','../CavalrYTP.jsc')\"",
		"test": "node --test test/*.test.mjs",
		"typecheck": "tsc -p tsconfig.json"
	},
	"devDependencies": {
		"@scenery/bundler": "^1.1.0",
		"@scenery/cavalry-types": "^1.1.0",
		"cross-env": "^10.1.0",
		"esbuild": "^0.27.2",
		"prettier": "^3.2.5",
		"typescript": "^5.9.3"
	},
	"engines": {
		"node": ">=24.3.0"
	},
	"dependencies": {
		"midi-file": "^1.2.4"
	}
}
